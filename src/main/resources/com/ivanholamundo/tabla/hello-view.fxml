               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <TableView fx:id="tablaPersonas" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
            <TableColumn fx:id="colApellido" prefWidth="120.0" text="Apellido" />
            <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha de nacimiento" />
        </columns>
